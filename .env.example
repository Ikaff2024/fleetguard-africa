# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL + PostGIS connection string
DATABASE_URL="postgresql://fleetguard:secret@localhost:5432/fleetguard_db?schema=public"

# JWT_SECRET: Secret for signing JWT access tokens
JWT_SECRET="super-secret-jwt-key-change-in-production"

# REDIS_URL: Redis URL for caching & BullMQ queues
REDIS_URL="redis://localhost:6379"

# S3_ENDPOINT: S3 compatible object storage endpoint for documents and receipts
S3_ENDPOINT="https://s3.af-south-1.amazonaws.com"
S3_BUCKET="fleetguard-africa-docs"

