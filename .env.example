###############################################################################
# FleetGuard Africa — variables d'environnement
#
# Copiez ce fichier vers `.env` et adaptez les valeurs.
# `.env` est ignoré par git : aucun secret réel ne doit jamais y être versionné.
#
# La configuration est validée au démarrage (src/server/env.ts). Une variable
# manquante ou invalide empêche le serveur de démarrer, plutôt que de produire
# un comportement dégradé découvert par le client.
###############################################################################

# --- Exécution ---------------------------------------------------------------
NODE_ENV=development
# La plupart des plateformes (Cloud Run, Render, Scaleway, Fly.io) injectent PORT
# à l'exécution. Ne jamais coder cette valeur en dur dans l'application.
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=debug

# --- Sécurité HTTP -----------------------------------------------------------
# Origines autorisées, séparées par des virgules. Vide = même origine seulement.
# En production, lister explicitement les domaines du tableau de bord.
CORS_ORIGINS=

# Nombre de proxies de confiance en amont (load balancer, CDN).
# Mal réglé, le rate limiting compte toutes les requêtes sur l'IP du proxy et
# bloque l'ensemble des utilisateurs.
TRUST_PROXY_HOPS=1

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
# L'IA est facturée au token : quota volontairement serré, par organisation.
RATE_LIMIT_AI_MAX=10

# --- Moteur d'analyse (Gemini) -----------------------------------------------
# Sans clé et hors mode démonstration, les routes d'IA répondent 503.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_MS=25000

# Mode démonstration : sert des exemples pré-écrits, marqués `isSimulated: true`
# et signalés visuellement dans l'interface.
# INTERDIT EN PRODUCTION — le serveur refuse de démarrer si NODE_ENV=production
# et AI_DEMO_MODE=true. Une donnée inventée ne doit jamais être indiscernable
# d'une analyse réelle : un gestionnaire pourrait sanctionner un chauffeur sur
# cette base.
AI_DEMO_MODE=false

# --- Base de données ---------------------------------------------------------
# Les ports ci-dessous correspondent à docker-compose.yml. Adaptez-les si votre
# poste héberge déjà un PostgreSQL ou un Redis.
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

DATABASE_URL="postgresql://fleetguard:fleetguard_local_only@localhost:5432/fleetguard_db?schema=public"

# Utilisateur applicatif soumis au Row-Level Security.
# En production, l'application DOIT se connecter avec ce rôle, jamais avec le
# propriétaire des tables : PostgreSQL exempte le propriétaire du RLS, et
# l'isolation entre clients disparaîtrait sans aucun signal.
DATABASE_APP_URL="postgresql://fleetguard_app:change_me_in_production@localhost:5432/fleetguard_db?schema=public"

# --- Cache et files ----------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# --- Authentification (Phase 1) ----------------------------------------------
# 32 caractères minimum. Générer avec : openssl rand -base64 48
# En production, ce secret vient d'un gestionnaire de secrets, pas d'un fichier.
JWT_SECRET=

# --- Stockage objet (documents de conformité) --------------------------------
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="fleetguard-africa-docs"
S3_ACCESS_KEY="fleetguard"
S3_SECRET_KEY="fleetguard_local_only"

# --- Cartographie (Phase 3) --------------------------------------------------
# Les tuiles OpenStreetMap publiques sont interdites en usage commercial par
# leur politique d'utilisation. Prévoir un fournisseur dédié avant le premier
# client payant.
MAPTILER_API_KEY=

# --- Notifications terrain (Phase 2) -----------------------------------------
# Agrégateur SMS local plutôt qu'un fournisseur international : sur les
# corridors UEMOA, l'écart de coût par message est d'un facteur 5.
SMS_PROVIDER_API_KEY=
SMS_SENDER_ID=FLEETGUARD
