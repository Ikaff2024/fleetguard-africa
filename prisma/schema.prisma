// FleetGuard Africa — schéma de données
//
// Dérivé de src/types/index.ts, qui reste la source de vérité du domaine.
//
// Trois principes structurent ce schéma :
//
//   1. `organizationId` est présent sur chaque table métier et indexé en tête
//      de chaque index composite. L'isolation est ensuite garantie par le
//      Row-Level Security PostgreSQL (voir prisma/sql/001_rls_policies.sql) :
//      même un bug applicatif ne peut pas faire fuiter les données d'un client
//      vers un autre.
//
//   2. Les identifiants sont des UUID, jamais des séquences. Un identifiant
//      incrémental exposé dans une URL permet d'énumérer les ressources et de
//      mesurer l'activité d'un concurrent.
//
//   3. Les géométries sont des types PostGIS (`Unsupported`), pas des paires de
//      flottants. Un test d'appartenance à une geofence doit être un
//      `ST_Contains` indexé, pas une boucle applicative sur des millions de points.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7 : l'URL de connexion vit dans prisma.config.ts (migrations) et dans
// l'adaptateur passé au client, plus dans ce fichier.
//
// Les extensions PostgreSQL (postgis, pgcrypto, pg_trgm, unaccent) ne sont pas
// déclarées ici volontairement : sur une base managée, `CREATE EXTENSION`
// relève de l'administrateur et l'utilisateur applicatif n'a pas ce droit.
// Elles sont installées par docker/postgres-init/01-extensions.sql en local et
// par l'exploitant en production. Les déclarer dans le schéma ferait voir à
// Prisma une dérive à chaque migration.
datasource db {
  provider = "postgresql"
}

// ============================================================================
// IDENTITÉ & MULTI-TENANCY
// ============================================================================

enum UserRole {
  SUPER_ADMIN
  ORGANIZATION_ADMIN
  FLEET_MANAGER
  SAFETY_OFFICER
  MAINTENANCE_TECH
  DRIVER
}

enum CurrencyCode {
  XOF
  XAF
  KES
  NGN
  GHS
  USD
  EUR
}

model Organization {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  code        String       @unique
  country     String
  currency    CurrencyCode
  timezone    String
  logoUrl     String?
  maxVehicles Int          @default(50)

  /**
   * Seuils de détection, ajustables par organisation.
   * Ils étaient constants dans le code : les valider avec un exploitant
   * demandait une modification et un déploiement. Or ils varient — la limite
   * poids lourds n'est pas la même au Bénin et au Kenya, et un transporteur
   * qui dessert des pistes n'a pas la même tolérance qu'un autre sur bitume.
   * Les valeurs par défaut restent celles du code : une organisation qui n'y
   * touche pas conserve exactement le comportement documenté.
   */
  openRoadSpeedLimitKmH       Int    @default(80)
  speedToleranceKmH           Int    @default(5)
  minOverspeedDurationSeconds Int    @default(30)
  nightStartHour              Int    @default(0)
  nightEndHour                Int    @default(5)
  contactEmail                String
  contactPhone                String

  // Suspension d'un client pour impayé sans destruction de ses données.
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  users            User[]
  vehicles         Vehicle[]
  drivers          Driver[]
  geofences        Geofence[]
  safetyEvents     SafetyEvent[]
  scoreConfigs     DriverScoreConfig[]
  dailyScores      DriverDailyScore[]
  maintenanceLogs  MaintenanceLog[]
  fuelLogs         FuelLog[]
  complianceDocs   ComplianceDoc[]
  auditLogs        AuditLog[]
  gpsPoints        GpsPoint[]
  telemetryBatches TelemetryBatch[]
  rewardProfiles   DriverRewardProfile[]
  trips            Trip[]
  alerts           Alert[]
  fuelStations     FuelStation[]
  missions         Mission[]
  driverMessages   DriverMessage[]

  @@index([code])
  @@map("organizations")
}

model User {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  email    String
  fullName String
  phone    String
  role     UserRole

  // Argon2id de préférence : plus résistant que bcrypt aux attaques par GPU.
  passwordHash    String
  // Invalide tous les jetons émis avant cette date (changement de mot de passe,
  // révocation d'accès d'un salarié qui quitte l'entreprise).
  tokensValidFrom DateTime @default(now())

  avatarUrl        String?
  isActive         Boolean   @default(true)
  lastLoginAt      DateTime?
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  driver        Driver?
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]

  // L'unicité de l'e-mail est globale : elle sert d'identifiant de connexion
  // et ne peut donc pas être réutilisée d'une organisation à l'autre.
  @@unique([email])
  @@index([organizationId, role])
  @@map("users")
}

model RefreshToken {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Seul le condensé est stocké : une fuite de la table ne donne aucun jeton
  // utilisable.
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  // Rotation : le jeton qui a remplacé celui-ci. Une réutilisation d'un jeton
  // déjà tourné signale un vol et doit révoquer toute la chaîne.
  replacedById String?   @db.Uuid

  userAgent String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
  @@map("refresh_tokens")
}

// ============================================================================
// FLOTTE
// ============================================================================

enum VehicleType {
  HEAVY_TRUCK
  MEDIUM_TRUCK
  VAN
  PICKUP
  BUS
  CONTAINER_CARRIER
}

enum VehicleStatus {
  ACTIVE
  MAINTENANCE
  IDLE
  OUT_OF_SERVICE
}

enum FuelType {
  DIESEL
  GASOLINE
  HYBRID
  ELECTRIC
}

model Vehicle {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  immatriculation String
  vin             String
  make            String
  model           String
  year            Int
  type            VehicleType
  fuelType        FuelType

  tankCapacityLiters        Decimal @db.Decimal(8, 2)
  // Référence de consommation : l'écart avec le relevé réel est le premier
  // signal de siphonnage.
  expectedConsumptionL100km Decimal @db.Decimal(6, 2)
  currentOdometerKm         Int     @default(0)

  status          VehicleStatus @default(ACTIVE)
  speedGovernorId String?
  gpsTrackerImei  String?
  lastServiceDate DateTime?
  nextServiceKm   Int?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  drivers          Driver[]
  safetyEvents     SafetyEvent[]
  maintenanceLogs  MaintenanceLog[]
  fuelLogs         FuelLog[]
  complianceDocs   ComplianceDoc[]
  gpsPoints        GpsPoint[]
  telemetryBatches TelemetryBatch[]
  trips            Trip[]
  alerts           Alert[]
  missions         Mission[]

  // Une immatriculation est unique au sein d'une organisation, pas mondialement :
  // deux transporteurs de pays différents peuvent porter la même plaque.
  @@unique([organizationId, immatriculation])
  @@unique([organizationId, vin])
  @@index([organizationId, status])
  @@index([gpsTrackerImei])
  @@map("vehicles")
}

enum DriverStatus {
  AVAILABLE
  ON_TRIP
  OFF_DUTY
  SUSPENDED
}

model Driver {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Un chauffeur n'a pas toujours de compte applicatif (pas de smartphone).
  userId String? @unique @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  fullName          String
  phone             String
  licenseNumber     String
  licenseCategory   String
  licenseExpiryDate DateTime

  assignedVehicleId String?  @db.Uuid
  assignedVehicle   Vehicle? @relation(fields: [assignedVehicleId], references: [id], onDelete: SetNull)

  // Dernier score calculé, conservé ici pour l'affichage des listes.
  // La vérité historique reste dans DriverDailyScore.
  currentSafetyScore Decimal @default(100) @db.Decimal(5, 2)
  totalKmDriven      Int     @default(0)

  status    DriverStatus @default(AVAILABLE)
  avatarUrl String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  safetyEvents     SafetyEvent[]
  dailyScores      DriverDailyScore[]
  fuelLogs         FuelLog[]
  complianceDocs   ComplianceDoc[]
  gpsPoints        GpsPoint[]
  telemetryBatches TelemetryBatch[]
  rewardProfile    DriverRewardProfile?
  unlockedBadges   DriverUnlockedBadge[]
  trips            Trip[]
  alerts           Alert[]
  missions         Mission[]
  messages         DriverMessage[]

  @@unique([organizationId, licenseNumber])
  @@index([organizationId, status])
  @@index([organizationId, currentSafetyScore])
  @@map("drivers")
}

// ============================================================================
// TÉLÉMÉTRIE
// ============================================================================

enum NetworkType {
  FOURG
  THREEG
  TWOG
  NONE
}

/// Lot de points remonté par un boîtier ou l'application mobile.
/// Sert de clé d'idempotence : un boîtier qui sort d'une zone blanche rejoue
/// fréquemment le même lot. Sans cette table, les infractions sont comptées
/// deux fois et le score du chauffeur — donc sa prime — est faussé.
model TelemetryBatch {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Identifiant fourni par l'équipement, unique par organisation.
  batchId  String
  deviceId String?

  vehicleId String  @db.Uuid
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driverId  String? @db.Uuid
  driver    Driver? @relation(fields: [driverId], references: [id], onDelete: SetNull)

  pointCount  Int
  sentAt      DateTime?
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@unique([organizationId, batchId])
  @@index([organizationId, receivedAt])
  @@map("telemetry_batches")
}

/// Trajet reconstruit à partir des points GPS.
///
/// Le cahier des charges demande « distance, durée, arrêts et historique ».
/// Un trajet n'est pas une donnée émise par le terrain : c'est une lecture des
/// points, matérialisée ici pour que les écrans et les rapports n'aient pas à
/// la refaire à chaque affichage — sur des dizaines de milliers de points, ce
/// recalcul permanent serait le premier goulot d'étranglement du produit.
model Trip {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  vehicleId String  @db.Uuid
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driverId  String? @db.Uuid
  driver    Driver? @relation(fields: [driverId], references: [id], onDelete: SetNull)

  startedAt DateTime
  endedAt   DateTime

  distanceKm      Decimal @db.Decimal(10, 2)
  durationSeconds Int
  /// Immobilisations de plus de quelques minutes pendant le trajet.
  stopCount       Int     @default(0)
  stopSeconds     Int     @default(0)

  maxSpeedKmH Decimal @db.Decimal(6, 2)
  avgSpeedKmH Decimal @db.Decimal(6, 2)

  startLatitude  Decimal @db.Decimal(9, 6)
  startLongitude Decimal @db.Decimal(9, 6)
  endLatitude    Decimal @db.Decimal(9, 6)
  endLongitude   Decimal @db.Decimal(9, 6)

  pointCount Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // La reconstruction est rejouable : un même départ ne crée qu'un trajet,
  // quel que soit le nombre de fois où les points sont réanalysés.
  @@unique([vehicleId, startedAt])
  @@index([organizationId, startedAt])
  @@index([organizationId, driverId, startedAt])
  @@map("trips")
}

/// Point GPS brut.
///
/// Volumétrie de référence : 500 véhicules × 8 h de roulage × 1 point/10 s
/// ≈ 43 millions de lignes par mois. Cette table est partitionnée par mois
/// (voir prisma/sql/002_partitioning.sql) : purger une période revient alors à
/// détacher une partition, opération instantanée, là où un DELETE massif
/// bloquerait la table et ferait exploser le volume WAL.
model GpsPoint {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  vehicleId String  @db.Uuid
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driverId  String? @db.Uuid
  driver    Driver? @relation(fields: [driverId], references: [id], onDelete: SetNull)

  recordedAt DateTime

  latitude  Decimal                                @db.Decimal(9, 6)
  longitude Decimal                                @db.Decimal(9, 6)
  // Colonne PostGIS alimentée par un trigger à partir de latitude/longitude.
  // C'est elle qui porte l'index spatial utilisé par le moteur de geofencing.
  location  Unsupported("geography(Point, 4326)")?

  altitude        Decimal?    @db.Decimal(8, 2)
  speedKmH        Decimal     @db.Decimal(6, 2)
  headingDegree   Int
  accuracyMeters  Decimal     @db.Decimal(8, 2)
  ignitionOn      Boolean
  batteryLevelPct Int
  networkType     NetworkType

  eventFlags String[]

  createdAt DateTime @default(now())

  // Index de tête : reconstituer le trajet d'un véhicule sur une période est
  // la requête la plus fréquente du produit.
  @@index([organizationId, vehicleId, recordedAt])
  @@index([organizationId, recordedAt])
  @@map("gps_points")
}

// ============================================================================
// SÉCURITÉ & SCORING
// ============================================================================

enum SafetyEventType {
  OVER_SPEED
  HARSH_BRAKING
  RAPID_ACCELERATION
  FATIGUE_NIGHT_DRIVING
  GEOFENCE_BREACH
  IDLING_EXCESS
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model SafetyEvent {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  vehicleId String  @db.Uuid
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driverId  String  @db.Uuid
  driver    Driver  @relation(fields: [driverId], references: [id], onDelete: Cascade)

  eventType SafetyEventType
  severity  Severity

  recordedAt DateTime
  latitude   Decimal                                @db.Decimal(9, 6)
  longitude  Decimal                                @db.Decimal(9, 6)
  location   Unsupported("geography(Point, 4326)")?

  speedKmH        Decimal  @db.Decimal(6, 2)
  speedLimitKmH   Decimal? @db.Decimal(6, 2)
  durationSeconds Int?
  description     String

  penaltyPointsDeducted Decimal @db.Decimal(5, 2)

  // Un chauffeur doit pouvoir contester une infraction, et la contestation
  // doit laisser une trace opposable.
  isDisputed       Boolean   @default(false)
  disputeNote      String?
  reviewedByUserId String?   @db.Uuid
  reviewedAt       DateTime?

  createdAt DateTime @default(now())

  @@index([organizationId, driverId, recordedAt])
  @@index([organizationId, eventType, recordedAt])
  @@map("safety_events")
}

/// Configuration de calcul du score, versionnée.
///
/// Le versionnement n'est pas optionnel : un score recalculé un an plus tard
/// avec des pondérations modifiées ne serait pas défendable devant un
/// chauffeur ou un inspecteur du travail. Chaque score conserve la version de
/// configuration qui l'a produit.
model DriverScoreConfig {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  version Int

  overspeedWeight      Decimal @db.Decimal(5, 2)
  harshBrakingWeight   Decimal @db.Decimal(5, 2)
  rapidAccelWeight     Decimal @db.Decimal(5, 2)
  fatigueNightWeight   Decimal @db.Decimal(5, 2)
  geofenceBreachWeight Decimal @db.Decimal(5, 2)

  normalizationDistanceKm Int @default(100)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dailyScores DriverDailyScore[]

  @@unique([organizationId, version])
  @@index([organizationId, isActive])
  @@map("driver_score_configs")
}

model DriverDailyScore {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  driverId String @db.Uuid
  driver   Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  configId String            @db.Uuid
  config   DriverScoreConfig @relation(fields: [configId], references: [id])

  date             DateTime @db.Date
  distanceDrivenKm Decimal  @db.Decimal(10, 2)
  score            Decimal  @db.Decimal(5, 2)

  overspeedCount        Int     @default(0)
  harshBrakingCount     Int     @default(0)
  rapidAccelCount       Int     @default(0)
  geofenceBreachesCount Int     @default(0)
  nightKmDriven         Decimal @default(0) @db.Decimal(10, 2)

  // Détail des points perdus, tel qu'affiché au chauffeur. Stocké et non
  // recalculé : l'explication doit rester identique à celle qui lui a été
  // présentée le jour même.
  penaltyExplanations Json

  createdAt DateTime @default(now())

  @@unique([driverId, date])
  @@index([organizationId, date])
  @@map("driver_daily_scores")
}

// ============================================================================
// GEOFENCING
// ============================================================================

enum GeofenceType {
  WAREHOUSE
  PORT
  BORDER_POST
  RESTRICTED_ZONE
  FUEL_STATION
  CUSTOM_CORRIDOR
}

model Geofence {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name String
  type GeofenceType

  // Géométrie unique pour les cercles comme pour les polygones : un cercle est
  // stocké comme le tampon (`ST_Buffer`) de son centre. Un seul index spatial
  // suffit alors, et le moteur n'a plus deux chemins de code à maintenir.
  area Unsupported("geography(Polygon, 4326)")?

  centerLat    Decimal? @db.Decimal(9, 6)
  centerLng    Decimal? @db.Decimal(9, 6)
  radiusMeters Int?

  speedLimitKmH       Int?
  maxDwellTimeMinutes Int?

  notifyOnEntry         Boolean @default(false)
  notifyOnExit          Boolean @default(false)
  notifyOnSpeeding      Boolean @default(false)
  notifyOnProlongedStay Boolean @default(false)

  notificationChannels String[]
  assignedVehicleIds   String[] @db.Uuid

  severity Severity @default(MEDIUM)
  isActive Boolean  @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([organizationId, isActive])
  @@map("geofences")
}

// ============================================================================
// MAINTENANCE, CARBURANT, CONFORMITÉ
// ============================================================================

enum MaintenanceType {
  PREVENTATIVE
  CORRECTIVE
  TIRE_REPLACEMENT
  OIL_CHANGE
  BRAKE_SERVICE
}

enum MaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

model MaintenanceLog {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  vehicleId String  @db.Uuid
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  type        MaintenanceType
  description String

  odometerKmAtService Int
  // Decimal et non Float : un montant financier ne tolère aucune approximation
  // binaire, surtout en XOF où l'unité n'a pas de décimale.
  cost                Decimal      @db.Decimal(14, 2)
  currency            CurrencyCode

  serviceProvider String
  technicianName  String?
  technicianNotes String?

  performedAt      DateTime
  nextServiceKmDue Int?
  status           MaintenanceStatus @default(COMPLETED)

  partsReplaced Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, vehicleId, performedAt])
  @@index([organizationId, status])
  @@map("maintenance_logs")
}

model FuelLog {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  vehicleId String  @db.Uuid
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driverId  String? @db.Uuid
  driver    Driver? @relation(fields: [driverId], references: [id], onDelete: SetNull)

  litersAdded   Decimal      @db.Decimal(10, 2)
  totalCost     Decimal      @db.Decimal(14, 2)
  pricePerLiter Decimal      @db.Decimal(10, 2)
  currency      CurrencyCode

  odometerKm     Int
  stationName    String
  receiptNumber  String?
  receiptFileUrl String?

  // Consommation calculée entre deux pleins.
  calculatedL100km   Decimal?  @db.Decimal(6, 2)
  // Signalement automatique, à confirmer humainement : une accusation de vol
  // ne peut pas reposer sur un seuil sans contrôle.
  suspectedFuelTheft Boolean   @default(false)
  reviewedByUserId   String?   @db.Uuid
  reviewedAt         DateTime?

  loggedAt  DateTime
  createdAt DateTime @default(now())

  @@index([organizationId, vehicleId, loggedAt])
  @@index([organizationId, suspectedFuelTheft])
  @@map("fuel_logs")
}

enum ComplianceDocType {
  INSURANCE
  TECHNICAL_INSPECTION
  CEDEAO_BROWN_CARD
  AXLE_LOAD_CERTIFICATE
  DRIVER_LICENSE
  HAZMAT_PERMIT
}

enum ComplianceStatus {
  VALID
  EXPIRING_SOON
  EXPIRED
}

model ComplianceDoc {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  vehicleId String?  @db.Uuid
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driverId  String?  @db.Uuid
  driver    Driver?  @relation(fields: [driverId], references: [id], onDelete: Cascade)

  title     String
  docType   ComplianceDocType
  docNumber String

  issuedDate DateTime
  expiryDate DateTime
  status     ComplianceStatus @default(VALID)

  fileUrl String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Requête quotidienne du planificateur d'alertes d'expiration : un camion
  // immobilisé à un poste frontière pour une carte brune périmée coûte
  // beaucoup plus cher que le renouvellement.
  @@index([organizationId, expiryDate])
  @@index([organizationId, status])
  @@map("compliance_docs")
}

// ============================================================================
// GAMIFICATION & PRIMES
// ============================================================================

enum PayoutStatus {
  ELIGIBLE
  CALCULATED
  APPROVED
  PAID
  ON_HOLD
}

enum PayoutMethod {
  ORANGE_MONEY
  MTN_MOMO
  WAVE
  FUEL_VOUCHER
}

model DigitalBadge {
  id          String @id @default(uuid()) @db.Uuid
  code        String @unique
  title       String
  description String
  category    String
  rarity      String
  iconName    String

  expBonusPoints      Int     @default(0)
  fuelBonusMultiplier Decimal @default(1) @db.Decimal(4, 2)
  criterion           String

  createdAt DateTime @default(now())

  unlockedBy DriverUnlockedBadge[]

  @@map("digital_badges")
}

model DriverUnlockedBadge {
  id String @id @default(uuid()) @db.Uuid

  driverId String       @db.Uuid
  driver   Driver       @relation(fields: [driverId], references: [id], onDelete: Cascade)
  badgeId  String       @db.Uuid
  badge    DigitalBadge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  unlockedAt  DateTime @default(now())
  periodLabel String
  grantedBy   String

  @@unique([driverId, badgeId, periodLabel])
  @@map("driver_unlocked_badges")
}

/// Profil de récompense d'un chauffeur.
///
/// Attention : verser une prime en monnaie électronique (Orange Money, MTN
/// MoMo, Wave) relève de la réglementation BCEAO et suppose un agrégateur
/// agréé. Tant que ce partenariat n'est pas signé, seul FUEL_VOUCHER doit être
/// utilisé. Voir PRODUCTION_PLAN.md § Conformité.
model DriverRewardProfile {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  driverId String @unique @db.Uuid
  driver   Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  ecoScore      Decimal @default(0) @db.Decimal(5, 2)
  scoreTrend30d Decimal @default(0) @db.Decimal(5, 2)

  fuelEfficiencySavingsL100km Decimal      @default(0) @db.Decimal(6, 2)
  estimatedFuelSavedLiters    Decimal      @default(0) @db.Decimal(10, 2)
  bonusEarned                 Decimal      @default(0) @db.Decimal(14, 2)
  currency                    CurrencyCode

  payoutStatus PayoutStatus @default(ELIGIBLE)
  payoutMethod PayoutMethod @default(FUEL_VOUCHER)
  lastPayoutAt DateTime?

  totalPoints   Int  @default(0)
  rankInCompany Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, payoutStatus])
  @@map("driver_reward_profiles")
}

// ============================================================================
// AUDIT
// ============================================================================

/// Journal d'audit.
///
/// Obligatoire dès lors que la plateforme traite des données de
/// géolocalisation nominatives : il faut pouvoir répondre à « qui a consulté
/// la position de ce chauffeur, et quand ». Table en insertion seule ; la
/// politique RLS interdit toute mise à jour et toute suppression.
model AuditLog {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId    String? @db.Uuid
  user      User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userEmail String

  action     String
  resource   String
  resourceId String?

  ipAddress String?
  userAgent String?
  details   Json?

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([organizationId, userId, createdAt])
  @@index([organizationId, resource, resourceId])
  @@map("audit_logs")
}

// ============================================================================
// ALERTES
// ============================================================================

enum AlertCategory {
  GEOFENCE
  HARSH_DRIVING
  FUEL_ANOMALY
  MAINTENANCE
  COMPLIANCE
}

enum AlertStatus {
  UNHANDLED
  IN_REVIEW
  RESOLVED
  DISMISSED
}

/// Alerte opérationnelle présentée au régulateur.
///
/// Deux natures cohabitent volontairement dans cette table.
///
/// Le constat — un excès de vitesse, une carte brune qui expire, une révision
/// dépassée — est *dérivé* de faits déjà enregistrés ailleurs. Il est donc
/// recalculable, et le sera : les seuils évoluent, les données arrivent en
/// retard depuis le terrain.
///
/// Le traitement — qui a pris connaissance de l'alerte, quand, ce qui a été
/// décidé — n'est dérivable de rien. C'est le travail d'un régulateur, et il
/// doit survivre à toute re-dérivation. Un acquittement perdu au rechargement
/// de la page, c'est un incident qu'on croit traité et qui ne l'est pas.
///
/// D'où le couple (sourceType, sourceId) : il identifie le fait à l'origine de
/// l'alerte et rend la dérivation idempotente. Recalculer met à jour le
/// constat sans jamais toucher au traitement.
model Alert {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  category AlertCategory
  severity Severity
  status   AlertStatus   @default(UNHANDLED)

  /// Fait à l'origine de l'alerte : « SAFETY_EVENT », « COMPLIANCE_DOC »,
  /// « VEHICLE_SERVICE », « FUEL_LOG ».
  sourceType String
  sourceId   String @db.Uuid

  recordedAt  DateTime
  title       String
  description String

  vehicleId String?  @db.Uuid
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driverId  String?  @db.Uuid
  driver    Driver?  @relation(fields: [driverId], references: [id], onDelete: Cascade)

  locationName String?
  latitude     Decimal? @db.Decimal(9, 6)
  longitude    Decimal? @db.Decimal(9, 6)

  /// Chiffre qui motive l'alerte, tel qu'il doit s'afficher (« 96 km/h »).
  metricValue String?
  metricLabel String?

  // --- Traitement : jamais écrasé par une re-dérivation ---
  acknowledgedAt     DateTime?
  acknowledgedByUser String?   @db.Uuid
  resolutionNote     String?
  resolvedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, sourceType, sourceId])
  @@index([organizationId, status, recordedAt])
  @@index([organizationId, category, recordedAt])
  @@map("alerts")
}

// ============================================================================
// RÉSEAU DE RAVITAILLEMENT
// ============================================================================

enum FuelBrand {
  TOTAL_ENERGIES
  ORYX
  CORLAY
  SHELL
  PUMA
  PETROCI
  STAR_OIL
  OTHER
}

/// Station de ravitaillement du réseau conventionné d'un transporteur.
///
/// Ce ne sont pas des points d'intérêt génériques : chaque entreprise négocie
/// ses accords avec une ou plusieurs enseignes, et ses cartes carburant ne
/// fonctionnent que dans ce réseau. Envoyer un chauffeur vers une station hors
/// convention lui impose d'avancer l'argent du plein. Les stations sont donc
/// rattachées à l'organisation, comme le reste.
///
/// Le prix porte sa date de relevé. Un tarif sans date induirait en erreur le
/// régulateur qui planifie un coût de mission : dans la sous-région, le prix à
/// la pompe bouge plusieurs fois par an et diffère d'un pays à l'autre.
model FuelStation {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name    String
  brand   FuelBrand
  address String
  city    String
  country String

  latitude  Decimal                                @db.Decimal(9, 6)
  longitude Decimal                                @db.Decimal(9, 6)
  location  Unsupported("geography(Point, 4326)")?

  // Services décisifs pour un poids lourd sur corridor : sans parking sécurisé,
  // une pause de nuit n'est pas envisageable.
  is24h                Boolean @default(false)
  hasAdBlue            Boolean @default(false)
  hasHeavyTruckParking Boolean @default(false)
  hasRestArea          Boolean @default(false)
  hasMechanic          Boolean @default(false)

  dieselPrice     Decimal?      @db.Decimal(10, 2)
  adbluePrice     Decimal?      @db.Decimal(10, 2)
  gasolinePrice   Decimal?      @db.Decimal(10, 2)
  currency        CurrencyCode?
  /// Date du relevé de prix. Sans elle, un tarif ne vaut rien.
  priceObservedAt DateTime?

  contactPhone String?
  isActive     Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([organizationId, name])
  @@index([organizationId, isActive])
  @@map("fuel_stations")
}

// ============================================================================
// PLANIFICATION DES MISSIONS
// ============================================================================

enum MissionStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/// Mission planifiée sur un corridor.
///
/// C'est la seule donnée de l'application qui porte sur l'avenir : tout le
/// reste constate ce qui s'est passé. Elle a donc une règle propre — une
/// mission ne peut pas être créée si elle fait dépasser les plafonds de
/// conduite, et ce contrôle s'appuie sur les heures *mesurées* à partir des
/// trajets reconstruits, jamais sur un carnet rempli de mémoire.
///
/// Le dépassement reste possible, mais jamais silencieux : un gestionnaire qui
/// passe outre doit le motiver, et la justification est conservée. En cas
/// d'accident, la question posée à l'entreprise sera précisément celle-là.
model Mission {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  vehicleId String  @db.Uuid
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driverId  String  @db.Uuid
  driver    Driver  @relation(fields: [driverId], references: [id], onDelete: Cascade)

  originLabel       String
  destinationLabel  String
  plannedDistanceKm Decimal @db.Decimal(10, 2)

  scheduledStart      DateTime
  scheduledEnd        DateTime
  /// Durée de conduite retenue au moment de la planification, en heures.
  plannedDrivingHours Decimal  @db.Decimal(5, 2)

  status MissionStatus @default(PLANNED)
  notes  String?

  /// Renseigné quand la mission a été validée malgré un dépassement constaté.
  overrideReason  String?
  createdByUserId String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, scheduledStart])
  @@index([organizationId, driverId, scheduledStart])
  @@index([organizationId, status])
  @@map("missions")
}

// ============================================================================
// CONSIGNES AUX CHAUFFEURS
// ============================================================================

enum DriverMessageCategory {
  SAFETY_REMINDER
  MISSION_UPDATE
  FUEL_INSTRUCTION
  MAINTENANCE_NOTICE
  GENERAL
}

enum DriverMessagePriority {
  NORMAL
  URGENT
  CRITICAL
}

/// Consigne adressée à un chauffeur, et sa réception réelle.
///
/// Cet écran affichait auparavant « Accusé de Lecture Signé » deux secondes
/// après l'envoi, sans qu'aucun chauffeur n'ait rien vu. Un exploitant qui
/// transmet « fortes pluies, réduisez à 60 km/h » lisait que le conducteur
/// avait signé. En cas d'accident, l'entreprise aurait produit la preuve d'un
/// avertissement qui n'avait jamais quitté le serveur.
///
/// Les trois horodatages ci-dessous ne sont donc écrits qu'au moment où le
/// fait se produit : `deliveredAt` quand le téléphone du chauffeur récupère la
/// consigne, `readAt` quand elle s'affiche devant lui, `acknowledgedAt` quand
/// il appuie lui-même sur le bouton. Aucun n'est renseigné à l'envoi, et aucun
/// ne peut l'être par le gestionnaire : ce qui vaut preuve, c'est justement que
/// l'expéditeur ne puisse pas l'écrire.
model DriverMessage {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  driverId String @db.Uuid
  driver   Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  /// Auteur de la consigne. Conservé même si le compte est supprimé plus tard :
  /// une consigne sans auteur ne vaut rien dans un dossier.
  senderUserId String? @db.Uuid
  senderName   String

  category DriverMessageCategory @default(GENERAL)
  priority DriverMessagePriority @default(NORMAL)
  body     String

  /// L'expéditeur exige une confirmation explicite du chauffeur.
  ackRequired Boolean @default(false)

  sentAt         DateTime  @default(now())
  /// Horodaté par le serveur quand le téléphone du chauffeur récupère la consigne.
  deliveredAt    DateTime?
  /// Horodaté quand la consigne s'affiche devant le chauffeur.
  readAt         DateTime?
  /// Horodaté quand le chauffeur confirme lui-même en avoir pris connaissance.
  acknowledgedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, driverId, sentAt])
  @@index([organizationId, sentAt])
  @@map("driver_messages")
}
